{
  "name": "hair-studio-showcase",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "check-deps": "expo install --check",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor --verbose",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "check-all": "npm run format:check && npm run lint && npm run check-deps && npm run doctor && npm run test",
    "sqlite:generate": "drizzle-kit generate",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "dependencies": {
    "@expo/app-integrity": "^55.0.16",
    "@expo/ui": "~55.0.17",
    "@op-engineering/op-sqlite": "^16.2.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/elements": "^2.9.14",
    "@sentry/react-native": "^8.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.97.0",
    "drizzle-orm": "^0.45.2",
    "expo": "^55.0.31",
    "expo-application": "~55.0.15",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-image-manipulator": "~55.0.16",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.14",
    "expo-media-library": "~55.0.17",
    "expo-router": "~55.0.14",
    "expo-sharing": "~55.0.19",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.14",
    "expo-system-ui": "~55.0.18",
    "i18next": "^26.0.2",
    "posthog-react-native": "^4.39.0",
    "react": "19.2.0",
    "react-i18next": "^17.0.1",
    "react-native": "0.83.10",
    "react-native-background-actions": "^4.1.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "5.1.1",
    "react-native-vision-camera-face-detector": "2.0.6",
    "react-native-vision-camera-worklets": "5.1.1",
    "react-native-worklets": "0.7.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tanstack/eslint-plugin-query": "^5.97.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "device-check",
          "react-native-background-actions"
        ]
      }
    }
  }
}
